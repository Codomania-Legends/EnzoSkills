{
  "name": "enzoskills",
  "version": "1.0.0",
  "scripts": {
    "start": "concurrently \"npm run backend\" \"npm run frontend\"",
    "backend": "cd ./backend && npm start",
    "frontend": "cd ./frontend && npm run dev",
    "install:all": "npm install && cd ./frontend && npm install && cd ../backend && npm install"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "dependencies": {
    "oxlint": "^1.89.0"
  }
}